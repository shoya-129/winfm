package winfm
import native.winfmplg
import std.thread
import std.fs


export struct Duration {
    h: Int
    min: Int
    sec: Int
    available: Bool
}

export struct Battery {
    percent: Int
    charging: Bool
    onAcPower: Bool
    saver: Bool
    remaining: Duration
    full: Duration
}

export fn extractSeconds(seconds: Int) -> Duration {
    if seconds < 0 {
        return Duration {
            h: 0
            min: 0
            sec: 0
            available: false
        }

    }

    let hours = seconds / 3600
    let minutes = (seconds % 3600) / 60
    let secs = seconds % 60

    return Duration {
        h: hours
        min: minutes
        sec: secs
        available: true
    }

}

export fn extractTime(ms: Int) -> Formula {
    let total_seconds = ms / 1000
    let hours = total_seconds / 3600
    let minutes = (total_seconds % 3600) / 60
    let seconds = total_seconds % 60

    return formula {
        h: hours,
        min: minutes,
        sec: seconds
    }

}

export const system = formula {
    // ─────────────────────────────────────
    // Session / Machine
    // ─────────────────────────────────────
    sleep: () {
        return winfmplg?.sleep()
    }

    lock: () {
        return winfmplg?.lock()
    }

    restart: () {
        return winfmplg?.restart()
    }

    shutdown: () {
        return winfmplg?.shutdown()
    }

    // ─────────────────────────────────────
    // System Information
    // ─────────────────────────────────────
    hostname: () {
        return winfmplg?.hostname()
    }

    username: () {
        return winfmplg?.username()
    }

    uptime: () {
        return extractTime(winfmplg?.uptime())
    }

    cpus: () {
        return winfmplg?.cpu_count()
    }

}

export const battery = formula {
    status: () {
        let handle = thread {
            let percent = winfmplg?.battery_percent()
            let charging = winfmplg?.battery_charging()
            let ac = winfmplg?.battery_on_ac_power()
            let saver = winfmplg?.battery_saver()
            let remaining = winfmplg?.battery_remaining_seconds()
            let full = winfmplg?.battery_full_seconds()
            let percent_value = percent.tryInt()
            let remaining_value = remaining.tryInt()
            let full_value = full.tryInt()

            return Battery {
                percent: percent_value
                charging: charging.tryBool()
                onAcPower: ac.tryBool()
                saver: saver.tryBool()
                remaining: extractSeconds(remaining_value)
                full: extractSeconds(full_value)
            }

        }

        return await handle
    }

    batterySaver: () {
        return winfmplg?.battery_saver()
    }

    batterySaverToggle: () {
        let saver = winfmplg?.battery_saver()
        let charging = winfmplg?.battery_charging()
        let ac = winfmplg?.battery_on_ac_power()

        // Never change power mode while connected to AC.
        if ac == true {
            return false
        }

        // Don't change power mode while charging.
        if charging == true {
            return false
        }

        if saver == false {
            return winfmplg?.enable_power_saving()
        }

        if saver == true {
            return winfmplg?.disable_power_saving()
        }

        return false
    }

}

export fn audio() -> Volume {
    winfmplg.Volume.init()
}

export fn clipboard() -> Clipboard {
    winfmplg.Clipboard.init()
}

export fn bluetooth() -> Bluetooth {
    winfmplg.Bluetooth.init()
}


